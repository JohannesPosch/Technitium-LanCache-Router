{
  // LanCache Router - shipped example. The app is installed but INACTIVE until "enabled" is true.
  // Replace the TEST-NET addresses and networks below with your own, then set "enabled": true.
  "enabled": false,

  "domainList": {
    "baseUrl": "https://raw.githubusercontent.com/uklans/cache-domains/master/",
    "refreshCron": "0 4 * * *",
    "refreshOnStartup": true,
    "services": { "include": [], "exclude": [] },
    "extraDomains": [],
    "excludeDomains": []
  },

  "healthCheckDefaults": {
    "type": "http",
    "port": 80,
    "path": "/lancache-heartbeat",
    "expectedStatus": [200, 204],
    "intervalSeconds": 10,
    "timeoutSeconds": 2,
    "failThreshold": 2,
    "successThreshold": 3
  },

  "cacheServers": [
    { "name": "cache-1", "enabled": true, "address": "192.0.2.10" }
  ],

  "routes": [
    {
      "priority": 10,
      "sourceCidr": "192.0.2.0/24",
      "server": "cache-1",
      "behavior": "cacheIfHealthy",
      "failover": { "action": "passthrough" },
      "comment": "clients with a direct path to the cache"
    }
  ],

  "dns": { "ttl": 60, "aaaaMode": "nodata", "httpsMode": "nodata" },
  "logging": { "queries": false }
}
