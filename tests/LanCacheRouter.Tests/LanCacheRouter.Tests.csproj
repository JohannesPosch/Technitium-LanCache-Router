<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LanCacheRouter\LanCacheRouter.csproj" />
  </ItemGroup>

  <!-- The app project marks these Private=false (the Technitium host provides them at runtime); tests need local copies. -->
  <ItemGroup>
    <Reference Include="DnsServerCore.ApplicationCommon">
      <HintPath>$(MSBuildThisFileDirectory)../../lib/DnsServerCore.ApplicationCommon.dll</HintPath>
    </Reference>
    <Reference Include="TechnitiumLibrary">
      <HintPath>$(MSBuildThisFileDirectory)../../lib/TechnitiumLibrary.dll</HintPath>
    </Reference>
    <Reference Include="TechnitiumLibrary.Net">
      <HintPath>$(MSBuildThisFileDirectory)../../lib/TechnitiumLibrary.Net.dll</HintPath>
    </Reference>
    <!-- Only needed to serialize DNS messages (wire-format tests). Those tests are skipped while the file is missing. -->
    <Reference Include="TechnitiumLibrary.IO" Condition="Exists('$(MSBuildThisFileDirectory)../../lib/TechnitiumLibrary.IO.dll')">
      <HintPath>$(MSBuildThisFileDirectory)../../lib/TechnitiumLibrary.IO.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The example configuration that ships in the app package must stay valid. -->
    <Content Include="..\..\src\LanCacheRouter\dnsApp.config" Link="shipped-dnsApp.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>